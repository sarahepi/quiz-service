# === Required ===
GROQ_API_KEY=your_groq_api_key_here

# === LLM Settings ===
GROQ_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0

# === Chunking ===
MAX_CHUNK_TOKENS=3000
OVERLAP_TOKENS=200
CHARS_PER_TOKEN=4.0

# === Application ===
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
MAX_QUESTIONS=20
MIN_QUESTIONS=1
